{
    "name": "cifs-backend",
    "version": "3.16.04",
    "license": "MIT",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --port 4200",
        "start:local": "ng serve --configuration=local",
        "start:dev": "ng serve --configuration=dev --port=4400",
        "start:dev-build": "ng serve --configuration=dev-build",
        "start:prod": "ng serve --configuration=production",
        "start:server": "node dist/index.js",
        "build": "ng build",
        "build:prod-x": "bash ./scripts/ng.sh build --prod --aot --configuration=production --build-optimizer",
        "build:dev-x": "bash ./scripts/ng.sh build --prod --aot --configuration=dev-build --build-optimizer",
        "build:prod": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --prod --aot --configuration=production --build-optimizer=false",
        "build:uat": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration=uat --build-optimizer=false",
        "build:office": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration=office --build-optimizer=false",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e"
    },
    "pre-commit": [
        "lint"
    ],
    "private": true,
